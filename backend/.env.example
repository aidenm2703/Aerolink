PORT=3000
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aerolink
DB_USER=root
DB_PASSWORD=coloca_tu_clave_local
CORS_ORIGIN=http://localhost:5173
# Alternativa local: DB_DIALECT=sqlite
# DB_STORAGE=./aerolink.sqlite

JWT_SECRET=reemplazar_por_una_clave_aleatoria_de_al_menos_32_bytes
JWT_EXPIRES_IN=1h


# IA v2: clave solo en backend; no usar variables VITE_ para secretos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

AGENT_DAILY_ENABLED=true
FRONTEND_URL=http://localhost:5173
# Opcional: webhook n8n con Header Auth X-Aerolink-Secret
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

