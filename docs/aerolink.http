# Día 2: iniciar sesión y pegar data.token en la variable token.
@token = pegar_token_aqui

### Registro público (usar correo nuevo)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{"nombre":"Operador","correo":"operador@example.com","password":"Prueba-segura-2026"}

### Login público
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{"correo":"operador@example.com","password":"Prueba-segura-2026"}

### Perfil protegido
GET http://localhost:3000/api/auth/me
Authorization: Bearer {{token}}

### Sin token: 401
GET http://localhost:3000/api/clientes

# Aerolink: 15 entidades. Usar BD de prueba y ajustar IDs tras cada creación.
@base = http://localhost:3000/api
@clientesId = 1
@casillerosId = 1
@enviosId = 1
@paquetesId = 1
@facturasId = 1
@paisesId = 1
@sucursalesId = 1
@bodegasId = 1
@ubicacionesId = 1
@transportistasId = 1
@serviciosId = 1
@tarifasId = 1
@movimientosId = 1
@entregasId = 1
@incidenciasId = 1

### Crear clientes
POST {{base}}/clientes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Ana",
  "apellidos": "Solano Mora",
  "correo": "ana@example.com",
  "telefono": "+50688887777",
  "identificacion": "112340567",
  "direccion": "San José, Costa Rica",
  "fechaRegistro": "2026-11-04",
  "estado": "activo"
}

### Listar clientes
GET {{base}}/clientes?page=1&limit=20
Authorization: Bearer {{token}}

### Ver uno
GET {{base}}/clientes/{{clientesId}}
Authorization: Bearer {{token}}

### Actualizar
PUT {{base}}/clientes/{{clientesId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Ana",
  "apellidos": "Solano Mora",
  "correo": "ana@example.com",
  "telefono": "+50688887777",
  "identificacion": "112340567",
  "direccion": "San José, Costa Rica",
  "fechaRegistro": "2026-11-04",
  "estado": "activo"
}

### Obligatorios: 400
POST {{base}}/clientes
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Estado inválido: 400
GET {{base}}/clientes?estado=invalido
Authorization: Bearer {{token}}

